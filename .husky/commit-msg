#!/bin/bash

# Conventional Commits 규칙에 따라 커밋 메시지를 검사하는 Git 훅입니다.

# 커밋 메시지 파일 경로를 첫 번째 인자로 받습니다.
COMMIT_MSG_FILE=$1
# 파일에서 첫 번째 줄(제목)을 읽어옵니다.
COMMIT_MSG=$(head -n1 "$COMMIT_MSG_FILE")

# 허용되는 커밋 타입 목록
ALLOWED_TYPES="feat|fix|docs|style|refactor|test|chore|ci|build"

# Conventional Commits 규칙에 맞는 정규표현식
# <type>(<scope>)!: <description> 형태를 검사합니다.
# scope와 !는 선택 사항입니다.
REGEX="^($ALLOWED_TYPES)(\(.+\))?(!)?: .+"
# --- 색상 코드 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # 색상 없음

# 정규표현식 검사
if [[ ! $COMMIT_MSG =~ $REGEX ]]; then
    echo -e "${RED}Error: 잘못된 커밋 메시지 형식입니다.${NC}" >&2
    echo -e "${YELLOW}커밋 메시지가 Conventional Commits 규칙을 따르지 않습니다.${NC}" >&2
    echo "" >&2
    echo -e "올바른 형식:" >&2
    echo -e "  ${GREEN}<type>[optional scope]: <description>${NC}" >&2
    echo "" >&2
    echo -e "예시:" >&2
    echo -e "  ${GREEN}feat: 새로운 로그인 기능 추가${NC}" >&2
    echo -e "  ${GREEN}fix(api): 데이터 파싱 오류 수정${NC}" >&2
    echo "" >&2
    echo -e "${YELLOW}허용되는 타입:${NC}" >&2
    echo -e "  - ${GREEN}feat${NC}: 새로운 기능 추가" >&2
    echo -e "  - ${GREEN}fix${NC}: 버그 수정" >&2
    echo -e "  - ${GREEN}docs${NC}: 문서 관련 변경" >&2
    echo -e "  - ${GREEN}style${NC}: 코드 스타일에 관한 변경 (포매팅, 세미콜론 등)" >&2
    echo -e "  - ${GREEN}refactor${NC}: 기능 변경 없는 코드 리팩토링" >&2
    echo -e "  - ${GREEN}test${NC}: 테스트 코드 추가 또는 수정" >&2
    echo -e "  - ${GREEN}build${NC}: 빌드 시스템 또는 외부 의존성 관련 변경" >&2
    echo -e "  - ${GREEN}chore${NC}: 빌드, 패키지 매니저 설정 등 기타 변경" >&2
    echo "" >&2
    echo -e "커다란 변화(Breaking Change)가 있을 경우, 타입/스코프 뒤에 '!'를 붙여주세요." >&2
    echo -e "  예: ${GREEN}refactor!: 사용자 인증 방식 변경${NC}" >&2
    # 0이 아닌 상태 코드로 종료하여 커밋을 중단시킵니다.
    exit 1
fi

# 규칙을 통과하면 0을 반환하여 커밋을 계속 진행합니다.
exit 0
